{
  // For the "Deploy to Cloudflare" button: serves dist/ and puts the access key into the form (see worker.js).
  // Only pages run the Worker; CSS, JS and images are served as free static assets.
  "name": "shoal",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/*", "!/_astro/*", "!/img/*", "!/favicon.svg", "!/apple-touch-icon.png", "!/og.jpg", "!/robots.txt", "!/sitemap-index.xml", "!/sitemap-0.xml"] }
}
