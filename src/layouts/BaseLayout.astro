---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource/metropolis/400.css";
import "@fontsource/metropolis/700.css";
import "../styles/global.css";
import Head, { type Props as HeadProps } from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideMenu from "../components/SideMenu.astro";
import ContactModal from "../components/ContactModal.astro";
import ConnectPill from "../components/ConnectPill.astro";
import { SITE } from "../config";

type Props = HeadProps & {
  /** Pages without a full-screen photo at the top start below a solid header. */
  plainTop?: boolean;
};
const { plainTop = false, ...props } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Head {...props} />
  </head>
  <body class={plainTop ? "plain-top" : undefined}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ConnectPill />
    <ContactModal />
    <SideMenu />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
  .plain-top main {
    padding-top: var(--header-h);
  }
  .plain-top .site-header {
    background: var(--paper);
    color: var(--ink);
  }
</style>
