---
import Icon from "./Icon.astro";
---

<button type="button" class="pill" data-open-contact data-key="pill">Let's Connect <Icon name="chevron-up" size={12} /></button>

<style>
  .pill {
    position: fixed;
    left: 19px;
    bottom: 28px;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 150px;
    height: 48px;
    border: 0;
    border-radius: 24px;
    background: var(--paper);
    color: #1a1a1a;
    box-shadow: 0 2px 14px rgb(0 0 0 / 0.18);
    font: 500 10px/16px var(--sans);
    letter-spacing: 0.4px;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.3s;
  }
  .pill:hover {
    transform: translateY(-2px);
  }
  @media (max-width: 767px) {
    .pill {
      left: 50%;
      margin-left: -75px;
    }
  }
</style>
