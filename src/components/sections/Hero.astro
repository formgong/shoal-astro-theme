---
import { SITE } from "../../config";
---

<section class="hero dark" data-key="hero">
  <img class="hero-img" src={`/img/${SITE.hero.image}`} alt={SITE.hero.alt} width="1920" height="1072" fetchpriority="high" decoding="async" />
  <div class="hero-content">
    <h1 class="h-hero" data-reveal="down" data-key="hero.h1">{SITE.name}</h1>
    <p data-reveal style="--delay:.1s" data-key="hero.sub">{SITE.tagline}</p>
  </div>
  <a href="#services" class="cue" data-reveal style="--delay:.1s" data-key="hero.cue">
    <svg class="cue-arc" viewBox="0 0 230 230" aria-hidden="true"><circle cx="115" cy="115" r="114" /></svg>
    <span>Scroll down</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-drift 24s ease-out both;
  }
  /* A still photo with a slow drift stands in for the reference's background video. */
  @keyframes hero-drift {
    from {
      transform: scale(1.08);
    }
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.12);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    width: 406px;
    max-width: calc(100% - 40px);
  }
  .cue {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 0;
    width: 230px;
    height: 106px;
    margin-left: -115px;
    overflow: hidden;
    text-decoration: none;
  }
  .cue-arc {
    position: absolute;
    left: 0;
    top: 0;
    width: 230px;
    height: 230px;
    fill: none;
    stroke: currentColor;
    stroke-dasharray: 6 6;
    animation: cue-spin 40s linear infinite;
  }
  @keyframes cue-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .cue span {
    position: absolute;
    left: 0;
    right: 0;
    top: 30px;
    font: 700 11px/16px var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 767px) {
    .cue {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-img,
    .cue-arc {
      animation: none;
    }
  }
</style>
