---
import { SITE } from "../../config";
---

<section class="areas dark" id="areas" data-key="areasHead">
  <div class="areas-head">
    <h2 class="h-section" data-reveal style="--delay:.1s" data-key="areas.h2">{SITE.areasTitle}</h2>
    <p data-reveal style="--delay:.2s" data-key="areas.p">{SITE.areasIntro}</p>
  </div>
  <div class="area-wrap" data-key="areas"><div class="area-grid">
    {
      SITE.areas.map((area, i) => (
        <article class="area" data-key={`area${i}`}>
          <a class="area-img" href={`/areas/${area.slug}/`} tabindex="-1" aria-hidden="true" data-key={i === 0 ? "area0.img" : undefined}>
            <img src={`/img/${area.image}`} alt="" width="1216" height="736" loading="lazy" decoding="async" />
          </a>
          <div class="area-text" data-reveal style="--delay:.3s">
            <h3 class="h-card" data-key={i === 0 ? "area0.title" : undefined}><a href={`/areas/${area.slug}/`}>{area.name}</a></h3>
            <p class="lead" data-key={i === 0 ? "area0.blurb" : undefined}>{area.blurb}</p>
          </div>
        </article>
      ))
    }
  </div></div>
</section>

<style>
  .areas {
    padding: 50px 0 90px;
    text-align: center;
  }
  .areas-head {
    width: 640px;
    max-width: calc(100% - 40px);
    margin: 0 auto;
  }
  .areas-head p {
    margin-top: 4px;
  }
  .area-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 606px));
    justify-content: center;
    column-gap: 52px;
    row-gap: 91px;
    margin-top: 48px;
    padding: 0 20px;
  }
  .area-img {
    display: block;
    height: 364px;
    overflow: hidden;
  }
  .area-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.75s ease-out;
  }
  .area:hover .area-img img {
    transform: scale(1.03);
  }
  .area-text {
    padding-top: 12px;
  }
  .area h3 a {
    text-decoration: none;
  }
  .area h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .area .lead {
    margin-top: 5px;
  }
  @media (max-width: 767px) {
    .areas {
      padding: 50px 0 55px;
    }
    .areas-head {
      max-width: 335px;
    }
    .areas-head .h-section {
      line-height: 42px;
    }
    .area-grid {
      grid-template-columns: minmax(0, 343px);
      row-gap: 55px;
      margin-top: 32px;
      padding: 0 16px;
    }
    .area-img {
      height: 206px;
    }
    .area .h-card {
      font-size: 32px;
      line-height: 45.7px;
    }
  }
</style>
