---
import { SITE } from "../../config";
---

<section class="meet dark" data-key="meet">
  <div class="meet-head">
    <p class="pretitle" data-reveal style="--delay:.1s" data-key="meet.pre">{SITE.meet.pretitle}</p>
    <h2 class="h-big" data-reveal style="--delay:.1s" data-key="meet.h2">{SITE.name}</h2>
    <p class="meet-text" data-reveal style="--delay:.2s" data-key="meet.p">{SITE.meet.text}</p>
  </div>
  <a class="meet-media" href="/about/" data-key="meet.media" aria-label={`More about ${SITE.name}`}>
    <img src={`/img/${SITE.meet.image}`} alt={SITE.meet.alt} width="1920" height="1072" loading="lazy" decoding="async" />
  </a>
</section>

<style>
  .meet {
    padding: 45px 0 50px;
    text-align: center;
  }
  .meet-head {
    width: 860px;
    max-width: calc(100% - 40px);
    margin: 0 auto;
  }
  .meet-head h2 {
    margin-top: 8px;
  }
  .meet-text {
    margin-top: 12px;
  }
  .meet-media {
    display: block;
    height: 680px;
    margin-top: 32px;
    overflow: hidden;
  }
  .meet-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transition: transform 0.75s ease-out;
  }
  .meet-media:hover img {
    transform: scale(1.03);
  }
  @media (max-width: 767px) {
    .meet-head {
      max-width: 335px;
    }
    .meet-media {
      height: 280px;
      margin-top: 16px;
    }
  }
</style>
