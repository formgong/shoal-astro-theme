---
import { SITE } from "../../config";
---

<section class="services" id="services" data-key="services">
  <h2 class="h-section services-title" data-reveal style="--delay:.1s" data-key="services.h2">{SITE.servicesTitle}</h2>
  <div class="tiles">
    {
      SITE.tiles.map((tile, i) => (
        <a class="tile" href={tile.href} data-key={`tile${i}`}>
          <span class="tile-img">
            <img src={`/img/${tile.image}`} alt={tile.alt} width="832" height="1024" loading="lazy" decoding="async" />
          </span>
          <h3 class="h-card tile-title" data-key={i === 0 ? "tile0.title" : undefined}>{tile.title}</h3>
        </a>
      ))
    }
  </div>
</section>

<style>
  .services {
    padding: 48px 0 79px;
  }
  .services-title {
    width: 640px;
    max-width: calc(100% - 40px);
    margin: 0 auto;
    text-align: center;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 347px);
    justify-content: center;
    column-gap: 14px;
    row-gap: 50px;
    margin-top: 70px;
  }
  .tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 426px;
    padding: 20px 15px;
    overflow: hidden;
    color: var(--paper);
    text-decoration: none;
  }
  .tile-img {
    position: absolute;
    inset: 0;
  }
  .tile-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.75s ease-out;
  }
  .tile::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: linear-gradient(rgb(0 0 0 / 0) 76.6%, #000);
    opacity: 0.6;
    transition: background-color 0.3s;
  }
  .tile-title {
    position: relative;
    z-index: 2;
    width: 100%;
    transition: 0.3s;
  }
  .tile-title::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 31px;
    height: 32px;
    border-bottom: 1px solid currentColor;
    opacity: 0;
    transition: 0.3s;
  }
  .tile:hover::before,
  .tile:focus-visible::before {
    background-color: #000;
  }
  .tile:hover .tile-title,
  .tile:focus-visible .tile-title {
    transform: translateY(-51px);
  }
  .tile:hover .tile-title::after,
  .tile:focus-visible .tile-title::after {
    opacity: 0.3;
    transform: translateY(20px);
  }
  .tile:hover .tile-img img,
  .tile:focus-visible .tile-img img {
    transform: scale(1.05);
  }
  @media (max-width: 1100px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 347px));
    }
  }
  @media (max-width: 767px) {
    .services {
      padding: 32px 0 29px;
    }
    .services-title {
      max-width: 335px;
    }
    .tiles {
      grid-template-columns: minmax(0, 335px);
      row-gap: 19.5px;
      margin-top: 30px;
    }
    .tile {
      height: 411px;
    }
  }
</style>
