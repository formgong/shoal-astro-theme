---
import { SITE } from "../../config";
---

<section class="cta dark" data-key="cta">
  <img class="cta-img" src={`/img/${SITE.cta.image}`} alt="" width="1920" height="1072" loading="lazy" decoding="async" />
  <span class="cta-line" aria-hidden="true"></span>
  <div class="cta-content">
    <h2 class="h-big" data-reveal style="--delay:.1s" data-key="cta.h2">{SITE.cta.title}</h2>
    <p data-reveal style="--delay:.2s" data-key="cta.p">{SITE.cta.text}</p>
    <button type="button" class="btn btn-light" data-reveal data-open-contact data-key="cta.btn">Let's Connect</button>
  </div>
</section>

<style>
  .cta {
    position: relative;
    height: 490px;
    overflow: hidden;
    text-align: center;
  }
  .cta-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.35);
  }
  .cta-line {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 60px;
    height: 54px;
    border-left: 1px dashed currentColor;
  }
  .cta-content {
    position: relative;
    z-index: 2;
    width: 490px;
    max-width: calc(100% - 40px);
    margin: 160px auto 0;
  }
  .cta-content p {
    margin-top: 28px;
  }
  .cta-content .btn {
    margin-top: 28px;
    width: 150px;
  }
  @media (max-width: 767px) {
    .cta {
      height: 496px;
    }
    .cta-content {
      max-width: 335px;
    }
  }
</style>
