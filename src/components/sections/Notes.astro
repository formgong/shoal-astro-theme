---
import { SITE } from "../../config";
const fmt = (iso: string) => new Date(iso + "T12:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<section class="notes" id="notes" data-key="notesHead">
  <div class="notes-head">
    <h2 class="h-section" data-reveal style="--delay:.1s" data-key="notes.h2">{SITE.notesTitle}</h2>
    <p data-reveal style="--delay:.2s" data-key="notes.p">{SITE.notesIntro}</p>
  </div>
  <div class="container post-grid">
    {
      SITE.notes.map((note, i) => (
        <a class="post" href={`/notes/${note.slug}/`} data-reveal style={`--delay:${(0.1 + i / 10).toFixed(1)}s`}>
          <span class="post-img">
            <img src={`/img/${note.image}`} alt="" width="1216" height="912" loading="lazy" decoding="async" />
            <span class="post-cat">{note.category}</span>
            <span class="post-more">Read more</span>
          </span>
          <h3 class="post-title">{note.title}</h3>
          <time class="post-date" datetime={note.date}>{fmt(note.date)}</time>
          <p class="post-sum">{note.summary}</p>
        </a>
      ))
    }
  </div>
</section>

<style>
  .notes {
    padding: 25px 0 90px;
    text-align: center;
  }
  .notes-head {
    width: 675px;
    max-width: calc(100% - 40px);
    margin: 0 auto;
  }
  .notes-head p {
    margin-top: 20px;
  }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 30px;
    margin-top: 56px;
    text-align: left;
  }
  .post {
    text-decoration: none;
  }
  .post-img {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .post-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .post-img::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0);
    transition: background 0.3s;
  }
  .post-cat {
    position: absolute;
    left: 16px;
    top: 16px;
    z-index: 1;
    padding: 2px 10px;
    background: var(--paper);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .post-more {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    padding: 11px 20px;
    background: var(--paper);
    font-weight: 700;
    text-transform: uppercase;
    opacity: 0;
    transform: translate(-50%, -30%);
    transition: 0.3s;
  }
  .post:hover .post-img img {
    transform: scale(1.1);
  }
  .post:hover .post-img::after {
    background: rgb(0 0 0 / 0.38);
  }
  .post:hover .post-more {
    opacity: 1;
    transform: translate(-50%, -50%);
  }
  .post-title {
    margin-top: 18px;
    font-size: 22px;
    line-height: 28px;
  }
  .post-date {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
  }
  .post-sum {
    margin-top: 8px;
  }
  @media (max-width: 900px) {
    .post-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
    }
  }
  @media (max-width: 767px) {
    .notes {
      padding: 32px 0 60px;
    }
    .notes-head {
      max-width: 335px;
    }
    .post-grid {
      padding: 0 20px;
      margin-top: 32px;
    }
  }
</style>
