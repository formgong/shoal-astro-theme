---
import { SITE } from "../config";
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
---

<footer class="site-footer" data-key="footer">
  <div class="container">
    <div class="footer-cols">
      <div class="fcol fcol-main" data-reveal style="--delay:.1s" data-key="fcol0">
        <p class="footer-mark" data-key="footer.logo">{SITE.brokerage}</p>
        <p class="footer-text">{SITE.footerText}</p>
      </div>
      <div class="fcol" data-reveal style="--delay:.3s" data-key="fcol1">
        <p class="footer-h">Office</p>
        <p><a href={`https://maps.google.com/?q=${encodeURIComponent(`${SITE.address.street}, ${SITE.address.city}`)}`}>{SITE.address.street}<br />{SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}</a></p>
      </div>
      <div class="fcol" data-reveal style="--delay:.6s" data-key="fcol2">
        <p class="footer-h">Contact {SITE.name.split(" ")[0]}</p>
        <p><a href={`tel:${SITE.phone.tel}`}>{SITE.phone.display}</a><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
    </div>
    <div class="footer-connect">
      <p class="footer-h connect-h">Connect with us</p>
      <ul class="socials">
        {SITE.social.map((s, i) => <li data-reveal style={`--delay:${i / 10}s`}><a href={s.href} aria-label={s.label} data-key={i === 0 ? "footer.social" : undefined}><Icon name={s.icon as "facebook"} size={16} /></a></li>)}
      </ul>
    </div>
    <div class="footer-bottom">
      <div class="footer-copy" data-reveal style="--delay:.6s" data-key="footer.copy">
        <p>Theme <a href="https://github.com/formgong/shoal-astro-theme">Shoal</a> by <a href="https://formgong.com">Formgong</a></p>
        <p>© {year} {SITE.name}</p>
      </div>
      <p class="disclaimer" data-reveal style="--delay:.6s">{SITE.disclaimer}</p>
      <ul class="footer-menu" data-reveal style="--delay:.6s" data-key="footer.menu">
        <li><a href="/">Home</a></li>
        <li><a href="/buying/">Buying</a></li>
        <li><a href="/selling/">Selling</a></li>
        <li><a href="/about/">Meet {SITE.name.split(" ")[0]}</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 150px 0 150px;
    background: var(--paper);
    color: var(--ink);
  }
  .footer-cols {
    display: grid;
    grid-template-columns: 300px 240px 240px;
    column-gap: 130px;
  }
  .fcol:nth-child(3) {
    margin-left: -80px;
  }
  .footer-mark {
    font: 340 22px/27px var(--serif);
    letter-spacing: 0.02em;
    margin-bottom: 26px;
  }
  .footer-connect {
    margin-top: 36px;
  }
  .footer-h {
    font: 600 15px/24px var(--serif);
    letter-spacing: 0.04em;
  }
  .connect-h {
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 0.08em;
  }
  .fcol a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .socials {
    display: flex;
    gap: 10px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid currentColor;
    border-radius: 50%;
    text-decoration: none;
    transition: background 0.3s;
  }
  .socials a:hover {
    background: #eee;
  }
  .footer-bottom {
    margin-top: 54px;
    padding-top: 40px;
    border-top: 1px solid var(--rule);
  }
  .footer-copy {
    display: flex;
    padding: 15px 0;
    justify-content: space-between;
    gap: 20px;
    font-size: 18px;
    line-height: 30px;
  }
  .footer-copy a:hover,
  .footer-menu a:hover {
    text-decoration: underline;
  }
  .footer-copy a {
    text-decoration: underline;
  }
  .disclaimer {
    margin-top: 26px;
    font-size: 12px;
    line-height: 21px;
    color: var(--muted);
  }
  .footer-menu {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px 34px;
    margin: 60px 0 0;
    padding: 0;
    list-style: none;
  }
  .footer-menu a {
    text-decoration: none;
  }
  @media (max-width: 1023px) {
    .footer-cols {
      grid-template-columns: 1fr;
      row-gap: 30px;
    }
    .fcol:nth-child(3) {
      margin-left: 0;
    }
  }
  @media (max-width: 767px) {
    .site-footer {
      padding: 150px 0 80px;
    }
    .site-footer .container {
      padding: 0 20px;
    }
    .footer-copy {
      flex-direction: column;
      font-size: 16px;
    }
    .footer-menu {
      justify-content: flex-start;
    }
  }
</style>
