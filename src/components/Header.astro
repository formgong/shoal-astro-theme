---
import { SITE } from "../config";
import Icon from "./Icon.astro";
---

<header class="site-header" data-header data-key="header">
  <div class="container header-inner">
    <a href="/" class="wordmark" aria-label={`${SITE.name}, home`}>{SITE.name}</a>
    <nav class="header-nav" aria-label="Main">
      <ul>
        {SITE.nav.map((item, i) => <li data-reveal style={`--delay:${(1 + i / 10).toFixed(1)}s`}><a class="nav-link" href={item.href} data-key={`nav${i}`}>{item.label}</a></li>)}
        <li data-reveal style={`--delay:${(1 + SITE.nav.length / 10).toFixed(1)}s`}><button type="button" class="nav-link" data-open-contact>Let's Connect</button></li>
        <li data-reveal style={`--delay:${(1.1 + SITE.nav.length / 10).toFixed(1)}s`}><a class="nav-link" href={`tel:${SITE.phone.tel}`}>{SITE.phone.display}</a></li>
      </ul>
    </nav>
    <button type="button" class="menu-btn" aria-label="Open menu" aria-controls="side-menu" data-open-menu>
      <Icon name="dots" size={22} />
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    color: var(--paper);
    transition: 0.3s;
  }
  .site-header.is-solid {
    background: var(--paper);
    color: var(--ink);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 45px;
    position: relative;
  }
  .header-inner::after {
    content: "";
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1px;
    border-bottom: 1px solid currentColor;
    opacity: 0.3;
  }
  .site-header.is-solid .header-inner::after {
    opacity: 0;
  }
  .wordmark {
    margin-right: auto;
    font: 340 22px/1 var(--serif);
    text-decoration: none;
    white-space: nowrap;
  }
  .header-nav ul {
    display: flex;
    gap: 45px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-link {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    font: 400 13px/15.6px var(--sans);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    border-bottom: 1px solid currentColor;
    transition: width 0.3s;
  }
  .nav-link:hover::after {
    width: 100%;
  }
  .menu-btn {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  @media (max-width: 1023px) {
    .header-nav {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .site-header {
      --header-h: 63px;
    }
    .header-inner {
      padding: 0 20px;
    }
    .header-inner::after {
      left: 20px;
      right: 20px;
    }
    .wordmark {
      font-size: 19px;
    }
  }
</style>
