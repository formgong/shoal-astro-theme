---
import { SITE } from "../config";
import Icon from "./Icon.astro";
const links = [
  { label: "Home", href: "/" },
  { label: "Meet Dana", href: "/about/" },
  { label: "Buying", href: "/buying/" },
  { label: "Selling", href: "/selling/" },
  ...SITE.areas.map((a) => ({ label: a.name, href: `/areas/${a.slug}/` })),
  { label: "Notes", href: "/#notes" },
  { label: "Contact", href: "/contact/" },
];
---

<dialog class="side-menu" id="side-menu" aria-label="Menu" data-side-menu>
  <div class="side-head">
    <a href="/" class="side-mark">{SITE.name}</a>
    <button type="button" class="side-close" aria-label="Close menu" data-close-dialog><Icon name="close" size={26} /></button>
  </div>
  <nav aria-label="All pages">
    <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  </nav>
  <div class="side-foot">
    <a href={`tel:${SITE.phone.tel}`}>{SITE.phone.display}</a>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </div>
</dialog>

<style>
  .side-menu {
    width: min(480px, 100%);
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0 40px 40px;
    border: 0;
    background: var(--ink);
    color: var(--paper);
  }
  .side-menu::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .side-menu[open] {
    animation: side-in 0.4s var(--ease);
  }
  @keyframes side-in {
    from {
      transform: translateX(100%);
    }
  }
  .side-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }
  .side-mark {
    font: 340 22px/1 var(--serif);
    text-decoration: none;
  }
  .side-close {
    padding: 4px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .side-menu ul {
    margin: 40px 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .side-menu nav a {
    font: 340 28px/36px var(--serif);
    text-decoration: none;
  }
  .side-menu nav a:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
  .side-foot {
    display: grid;
    gap: 6px;
  }
</style>
