---
/** Inner-page layout: a title block, then a narrow column of text. */
interface Props {
  pretitle?: string;
  title: string;
  lead?: string;
  image?: string;
  alt?: string;
}
const { pretitle, title, lead, image, alt = "" } = Astro.props;
---

<article class="prose-page">
  <header class="prose-head">
    {pretitle && <p class="pretitle" data-reveal>{pretitle}</p>}
    <h1 class="h-big" data-reveal style="--delay:.1s">{title}</h1>
    {lead && <p class="lead prose-lead" data-reveal style="--delay:.2s">{lead}</p>}
  </header>
  {image && <img class="prose-img" src={`/img/${image}`} alt={alt} width="1920" height="1072" loading="eager" decoding="async" />}
  <div class="prose-body">
    <slot />
  </div>
</article>

<style>
  .prose-page {
    padding: 80px 0 110px;
  }
  .prose-head {
    width: 760px;
    max-width: calc(100% - 40px);
    margin: 0 auto;
    text-align: center;
  }
  .prose-head h1 {
    margin-top: 8px;
  }
  .prose-lead {
    margin-top: 20px;
  }
  .prose-img {
    width: 100%;
    height: 520px;
    margin-top: 56px;
    object-fit: cover;
  }
  .prose-body {
    width: 680px;
    max-width: calc(100% - 40px);
    margin: 56px auto 0;
    font-size: 16px;
    line-height: 28px;
  }
  .prose-body :global(h2) {
    margin: 48px 0 16px;
    font-size: 30px;
    line-height: 38px;
  }
  .prose-body :global(p + p) {
    margin-top: 16px;
  }
  .prose-body :global(ol),
  .prose-body :global(ul) {
    padding-left: 20px;
  }
  .prose-body :global(li + li) {
    margin-top: 10px;
  }
  .prose-body :global(dl) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 10px 24px;
    margin: 32px 0;
    padding: 24px 0;
    border-block: 1px solid var(--rule);
  }
  .prose-body :global(dt) {
    font-weight: 700;
  }
  .prose-body :global(dd) {
    margin: 0;
  }
  .prose-body :global(.btn) {
    margin-top: 32px;
  }
  @media (max-width: 767px) {
    .prose-page {
      padding: 48px 0 80px;
    }
    .prose-img {
      height: 260px;
    }
    .prose-body :global(dl) {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .prose-body :global(dd) {
      margin-bottom: 10px;
    }
  }
</style>
