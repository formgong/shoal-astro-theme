---
import { SITE } from "../config";
import ContactForm from "./ContactForm.astro";
import Icon from "./Icon.astro";
---

<dialog class="contact-modal" id="contact-modal" aria-labelledby="contact-modal-title" data-contact-modal>
  <div class="modal-inner">
    <button type="button" class="modal-close" aria-label="Close" data-close-dialog><Icon name="close" size={26} /></button>
    <div class="modal-col">
      <h2 class="modal-title" id="contact-modal-title">Get In Touch</h2>
      <p class="modal-intro">Tell me what you are looking for and I will get back to you today.</p>
      <ContactForm id="modal" />
    </div>
    <div class="modal-aside">
      <p class="modal-name">{SITE.name}</p>
      <p><a href={`tel:${SITE.phone.tel}`}>{SITE.phone.display}</a><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p class="modal-label">Office</p>
      <p>{SITE.brokerage}<br />{SITE.address.street}<br />{SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}</p>
    </div>
  </div>
</dialog>

<style>
  .contact-modal {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }
  .contact-modal::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  .contact-modal[open] {
    animation: modal-in 0.4s var(--ease);
  }
  @keyframes modal-in {
    from {
      opacity: 0;
    }
  }
  .modal-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 560px) 260px;
    justify-content: center;
    gap: 120px;
    min-height: 100%;
    padding: 110px 30px 60px;
  }
  .modal-close {
    position: absolute;
    top: 26px;
    right: 30px;
    padding: 6px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .modal-title {
    font-size: 70px;
    line-height: 63px;
  }
  .modal-intro {
    margin: 24px 0 36px;
  }
  .modal-aside {
    display: grid;
    align-content: start;
    gap: 8px;
    padding-top: 12px;
  }
  .modal-name {
    font: 340 26px/32px var(--serif);
    margin-bottom: 8px;
  }
  .modal-label {
    margin-top: 24px;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  @media (max-width: 900px) {
    .modal-inner {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 90px 20px 40px;
    }
    .modal-title {
      font-size: 44px;
      line-height: 48px;
    }
  }
</style>
