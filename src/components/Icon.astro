---
/** Small inline icons. Stroke icons follow currentColor. */
interface Props {
  name: "facebook" | "instagram" | "linkedin" | "chevron-up" | "close" | "dots" | "play";
  size?: number;
  class?: string;
}
const { name, size = 16, class: className } = Astro.props;
const paths: Record<Props["name"], string> = {
  facebook: '<path d="M14 8h3V4h-3c-2.8 0-4 1.9-4 4.4V11H7v4h3v9h4v-9h3l1-4h-4V8.6c0-.4.2-.6.6-.6z" fill="currentColor" stroke="none"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="16.9" cy="7.1" r=".9" fill="currentColor" stroke="none"/>',
  linkedin: '<path d="M5.2 9h3.2v10H5.2zM6.8 4.2a1.85 1.85 0 1 1 0 3.7 1.85 1.85 0 0 1 0-3.7zM10.4 9h3.06v1.37h.04c.43-.81 1.47-1.66 3.03-1.66 3.23 0 3.83 2.13 3.83 4.9V19h-3.2v-4.8c0-1.15-.02-2.62-1.6-2.62-1.6 0-1.84 1.25-1.84 2.54V19h-3.2z" fill="currentColor" stroke="none"/>',
  "chevron-up": '<path d="m7 14 5-5 5 5"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  dots: '<circle cx="8" cy="8" r="1.6" fill="currentColor" stroke="none"/><circle cx="16" cy="8" r="1.6" fill="currentColor" stroke="none"/><circle cx="8" cy="16" r="1.6" fill="currentColor" stroke="none"/><circle cx="16" cy="16" r="1.6" fill="currentColor" stroke="none"/>',
  play: '<path d="M9 7v10l8-5z" fill="currentColor" stroke="none"/>',
};
---

<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />
