---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex plainTop>
  <section class="nf">
    <h1 class="h-big">This page is not here.</h1>
    <p>It may have sold. Try the home page or the island guides.</p>
    <a class="btn btn-solid" href="/">Home page</a>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    justify-items: center;
    gap: 24px;
    padding: 140px 20px;
    text-align: center;
  }
</style>
