---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE } from "../config";
---

<BaseLayout title="Contact" description={`Call, email or write to ${SITE.name}. Replies the same day.`} plainTop>
  <section class="contact-page container">
    <div>
      <h1 class="h-big" data-reveal>Get In Touch</h1>
      <p class="intro" data-reveal style="--delay:.1s">Tell me which island you are thinking about and when. I reply the same day.</p>
      <ContactForm id="page" />
    </div>
    <aside class="contact-aside">
      <p class="h-card">{SITE.name}</p>
      <p><a href={`tel:${SITE.phone.tel}`}>{SITE.phone.display}</a><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p>{SITE.brokerage}<br />{SITE.address.street}<br />{SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}</p>
    </aside>
  </section>
</BaseLayout>

<style>
  .contact-page {
    display: grid;
    grid-template-columns: minmax(0, 560px) 260px;
    justify-content: space-between;
    gap: 60px;
    padding-top: 80px;
    padding-bottom: 110px;
  }
  .intro {
    margin: 20px 0 32px;
  }
  .contact-aside {
    display: grid;
    align-content: start;
    gap: 16px;
    padding-top: 14px;
  }
  @media (max-width: 900px) {
    .contact-page {
      grid-template-columns: 1fr;
      padding-top: 48px;
    }
  }
</style>
