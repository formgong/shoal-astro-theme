---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import { SITE } from "../../config";

export function getStaticPaths() {
  return SITE.areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}
const { area } = Astro.props;
---

<BaseLayout title={`${area.name} homes`} description={`${area.name}: ${area.blurb} A buyer's guide by ${SITE.name}.`} plainTop>
  <Prose pretitle="Island guide" title={area.name} lead={area.blurb} image={area.image} alt={area.alt}>
    {area.body.map((p) => <p>{p}</p>)}
    <dl>
      {area.facts.map((fact) => (<><dt>{fact.label}</dt><dd>{fact.value}</dd></>))}
    </dl>
    <button type="button" class="btn btn-solid" data-open-contact>Ask about {area.name}</button>
  </Prose>
</BaseLayout>
