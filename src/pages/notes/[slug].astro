---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import { SITE } from "../../config";

export function getStaticPaths() {
  return SITE.notes.map((note) => ({ params: { slug: note.slug }, props: { note } }));
}
const { note } = Astro.props;
const date = new Date(note.date + "T12:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<BaseLayout title={note.title} description={note.summary} plainTop>
  <Prose pretitle={`${note.category} · ${date}`} title={note.title} lead={note.summary} image={note.image} alt={note.alt}>
    {note.body.map((p) => <p>{p}</p>)}
    <button type="button" class="btn btn-solid" data-open-contact>Ask Dana</button>
  </Prose>
</BaseLayout>
