---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
---

<BaseLayout title="Thank you" noindex plainTop>
  <section class="done">
    <h1 class="h-big">Thank you, your message is in.</h1>
    <p>Dana replies the same day, usually within a few hours. If it can't wait, call <a href={`tel:${SITE.phone.tel}`}>{SITE.phone.display}</a>.</p>
    <a class="btn btn-solid" href="/">Back to the home page</a>
  </section>
</BaseLayout>

<style>
  .done {
    display: grid;
    justify-items: center;
    gap: 24px;
    max-width: 640px;
    margin: 0 auto;
    padding: 120px 20px;
    text-align: center;
  }
</style>
